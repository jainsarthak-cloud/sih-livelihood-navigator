# Application Configuration
APP_NAME=Livelihood-Assistant-AI
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Security & CORS
# Use explicit origins. Wildcard is rejected when APP_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional AI extraction. Leave empty when using deterministic endpoints only.
# Never commit a populated .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20

# Phase 7 — ASR (use a locally provisioned multilingual Whisper model)
ASR_MODEL_PATH=
ASR_MODEL_VERSION=large-v3
ASR_MAX_AUDIO_BYTES=10000000

# Phase 11 — orchestration version
LIVELIHOOD_ASSESSMENT_VERSION=phase-11-orchestrator-v1

# Regional & Rules Data Paths
DATA_DIR=./data
SEED_DATA_DIR=./data/seed

# Phase 4 — deterministic skill normalization
# Inputs below the confidence threshold remain UNKNOWN.
SKILL_NORMALIZATION_MIN_CONFIDENCE=0.90
SKILL_NORMALIZATION_PHRASE_CONFIDENCE=0.95

# Phase 5 — recommendation component weights (must total 1.0)
RECOMMENDATION_INTEREST_WEIGHT=0.25
RECOMMENDATION_SKILL_WEIGHT=0.20
RECOMMENDATION_ELIGIBILITY_WEIGHT=0.20
RECOMMENDATION_LOCAL_OPPORTUNITY_WEIGHT=0.15
RECOMMENDATION_LABOUR_DEMAND_WEIGHT=0.10
RECOMMENDATION_EMPLOYMENT_PREFERENCE_WEIGHT=0.10
